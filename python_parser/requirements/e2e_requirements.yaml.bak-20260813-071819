meta:
  name: E2E Body & Chassis requirements
  version: '2'
  signal_map:
    DoorLock: E2E_Door_Lock_State
    LockButton: E2E_Lock_Request
    Speed: E2E_Vehicle_Speed
    Wiper: E2E_Wiper_Mode
    Rain: E2E_Rain_Detected
    DoorFL: E2E_Door_FL_State
    Trunk: E2E_Trunk_State
  derived_signals:
  - name: vehicle_moving
    from:
    - Speed
    cases:
    - value: moving
      when:
      - Speed > 5
    - value: stationary
      when:
      - Speed <= 5
rules:
- id: E2E_R1
  title: Doors must lock within 500 ms of a lock button press
  kind: response
  severity: high
  component: driver_door
  preconditions:
  - DoorFL == 'Closed'
  trigger:
    signal: LockButton
    to: Lock_Pressed
  expect:
    signal: DoorLock
    becomes: Locked
  deadline_ms: 400
  violation_title: Doors did not lock (in time) after lock button press
  check_list:
  - Key fob battery / E2E_Lock_Request reaching the body ECU
  - Door lock actuator wiring (E2E_Door_Lock_State)
  - Body ECU <-> body gateway on E2E_Body_CAN
- id: E2E_A1
  title: Doors must never unlock while the vehicle is moving
  component: driver_door
  severity: critical
  kind: absence
  while:
  - vehicle_moving == 'moving'
  forbidden:
    signal: DoorLock
    to: Unlocked
  violation_title: Doors unlocked while the vehicle was moving
  check_list:
  - Speed signal plausibility (E2E_Vehicle_Speed)
  - Unexpected unlock source on E2E_Body_CAN
- id: E2E_A2
  title: Wipers must never switch off while rain is detected
  component: wiper_module
  severity: medium
  kind: absence
  while:
  - Rain == 'Raining'
  forbidden:
    signal: Wiper
    to: 'Off'
  violation_title: Wipers switched off while it was raining
- id: E2E_D1
  title: Unlocked car with closed doors must auto-relock within 5 s
  component: body_ecu
  severity: medium
  kind: duration
  state:
  - DoorLock == 'Unlocked'
  - DoorFL == 'Closed'
  duration_ms: 5000
  expect:
    signal: DoorLock
    becomes: Locked
  violation_title: Car stayed unlocked longer than the 5 s auto-relock window
- id: E2E_I1
  title: Driver door state machine transitions
  component: driver_door
  severity: high
  kind: invariant
  state_signal: DoorFL
  allowed_transitions:
  - - Closed
    - Opening
  - - Opening
    - Open
  - - Open
    - Closing
  - - Closing
    - Closed
  - - Closed
    - Ajar
  - - Ajar
    - Closed
  violation_title: Driver door made an illegal state transition
- id: E2E_I2
  title: Trunk and hood must stay closed while the vehicle is moving
  component: trunk
  severity: high
  kind: invariant
  when:
  - vehicle_moving == 'moving'
  expect_all:
  - Trunk == 'Closed'
  - E2E_Hood_State == 'Closed'
  violation_title: Trunk or hood open while the vehicle was moving
- id: E2E_DR1
  title: Trunk release must open the trunk within 2 s (draft)
  component: trunk
  severity: low
  kind: response
  draft: true
  trigger:
    signal: LockButton
    to: Trunk_Release
  expect:
    signal: Trunk
    becomes: Open
  deadline_ms: 2000
- id: E2E_TMP
  kind: response
  severity: medium
  trigger:
    signal: E2E_Gear_Position
    to: Park
  expect:
    signal: E2E_Brake_Pedal
    becomes: Released
  deadline_ms: 1000
