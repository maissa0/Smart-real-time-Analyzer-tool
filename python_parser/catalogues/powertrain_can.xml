<?xml version="1.0" encoding="UTF-8"?>
<Bus Name="Powertrain_CAN">

    <massage id="0x100" name="Engine_Status">
        <Byte Num="0">
            <Signal Bit="11111111">
                <signal_name>Engine_RPM_High</signal_name>
                <values>
                    <value>0</value><name>Idle</name>
                    <value>1</value><name>Low</name>
                    <value>2</value><name>Medium</name>
                    <value>3</value><name>High</name>
                    <value>4</value><name>Redline</name>
                </values>
            </Signal>
        </Byte>
        <Byte Num="1">
            <Signal Bit="00001111">
                <signal_name>Engine_RPM_Low</signal_name>
                <values>
                    <value>0</value><name>Normal</name>
                    <value>1</value><name>Elevated</name>
                    <value>2</value><name>Critical</name>
                </values>
            </Signal>
            <Signal Bit="11110000">
                <signal_name>Engine_Load</signal_name>
                <values>
                    <value>0</value><name>No_Load</name>
                    <value>1</value><name>Light</name>
                    <value>2</value><name>Moderate</name>
                    <value>3</value><name>Heavy</name>
                    <value>4</value><name>Max</name>
                </values>
            </Signal>
        </Byte>
        <Byte Num="2">
            <Signal Bit="00001111">
                <signal_name>Engine_Temp</signal_name>
                <values>
                    <value>0</value><name>Cold</name>
                    <value>1</value><name>Warming</name>
                    <value>2</value><name>Normal</name>
                    <value>3</value><name>Hot</name>
                    <value>4</value><name>Overheat</name>
                </values>
            </Signal>
            <Signal Bit="11110000">
                <signal_name>Engine_State</signal_name>
                <values>
                    <value>0</value><name>Off</name>
                    <value>1</value><name>Cranking</name>
                    <value>2</value><name>Running</name>
                    <value>3</value><name>Stall</name>
                </values>
            </Signal>
        </Byte>
    </massage>

